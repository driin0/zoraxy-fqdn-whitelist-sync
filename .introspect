{
 "id": "io.github.driin0.zoraxy.fqdn_whitelist_sync",
 "name": "FQDN Whitelist Sync",
 "author": "driin0",
 "author_contact": "driin0@users.noreply.github.com",
 "description": "Keeps access-control whitelists in sync with resolved FQDNs and published CDN provider ranges",
 "url": "https://github.com/driin0/zoraxy-fqdn-whitelist-sync",
 "type": 1,
 "version_major": 1,
 "version_minor": 2,
 "version_patch": 0,
 "static_capture_paths": null,
 "static_capture_ingress": "",
 "dynamic_capture_sniff": "",
 "dynamic_capture_ingress": "",
 "ui_path": "/ui",
 "subscription_path": "",
 "subscriptions_events": null,
 "permitted_api_endpoints": [
  {
   "method": "GET",
   "endpoint": "/plugin/api/access/list",
   "reason": "List access rules for the UI dropdown and whitelist-mode warning"
  },
  {
   "method": "GET",
   "endpoint": "/plugin/api/whitelist/list",
   "reason": "Read the current whitelist to reconcile"
  },
  {
   "method": "POST",
   "endpoint": "/plugin/api/whitelist/ip/add",
   "reason": "Add resolved FQDN addresses and published CDN provider ranges to the whitelist"
  },
  {
   "method": "POST",
   "endpoint": "/plugin/api/whitelist/ip/remove",
   "reason": "Remove stale FQDN addresses and provider ranges from the whitelist"
  }
 ]
}
